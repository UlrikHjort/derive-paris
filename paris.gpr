with "gtkada";

project Paris is
   for Source_Dirs use ("src/common", "src/game");
   for Object_Dir use "obj/game";
   for Exec_Dir use "bin";
   for Main use ("paris.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2012", "-gnatwa", "-gnatwl", "-gnatyN");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lepoxy", "-lz");
   end Linker;
end Paris;
